# Copia este archivo como .env (opcional: todo tiene valores por defecto para la demo)
PORT=7071
JWT_SECRET=cambia-esto-en-produccion
JWT_REFRESH_SECRET=cambia-esto-tambien
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
DB_PATH=api/data/wms.db
# Base de datos en la nube con Turso (libSQL). Si se dejan vacíos, usa solo SQLite local.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
CORS_ORIGIN=http://localhost:4200
# URL que usa el simulador GPS para enviar posiciones
INGEST_URL=http://localhost:7071/api
# Modo demo: umbrales cortos (segundos) para parada prolongada y pérdida de señal
DEMO_MODE=true
